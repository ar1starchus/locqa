  "schTutorialToGame": "Oiynğa!",
  "schTutorialPickSideTitle": "Qai tarapta ekeniñdi tañda!",
  "schTutorialPickSideSubtitle": "Tarapty tañdağannan keiin komandany auystyru mümkin bolmaidy",
